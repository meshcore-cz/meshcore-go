//go:build js && wasm

// Template: copy to your project as wasm/main.go
//
// Wires meshpkt.Ops to the browser via a global JS object (default name: meshcore).
// Each Op becomes a function that accepts positional arguments and returns
// {…result} on success or {error: "…"} on failure.
//
// ParamHex args are hex strings decoded before Run; byte results are hex-encoded
// inside each Op's Run implementation.
//
// Build:
//   GOOS=js GOARCH=wasm go build -o web/public/meshcore.wasm ./wasm
// Runtime:
//   cp "$(go env GOROOT)/lib/wasm/wasm_exec.js" web/public/
//   Load wasm_exec.js before instantiating the .wasm module.
package main

import (
	"encoding/hex"
	"encoding/json"
	"fmt"
	"syscall/js"

	"github.com/meshcore-cz/meshcore-go/meshpkt"
)

const globalName = "meshcore" // change if you need a different window property

func main() {
	mc := js.Global().Get("Object").New()

	for _, op := range meshpkt.Ops {
		op := op // capture for closure
		mc.Set(op.Name, js.FuncOf(func(_ js.Value, jsArgs []js.Value) any {
			if len(jsArgs) < len(op.Params) {
				return toJS(map[string]any{
					"error": fmt.Sprintf("%s: need %d arg(s), got %d", op.Name, len(op.Params), len(jsArgs)),
				})
			}

			args := make([]any, len(op.Params))
			for i, p := range op.Params {
				switch p.Kind {
				case meshpkt.ParamString:
					args[i] = jsArgs[i].String()
				case meshpkt.ParamHex:
					b, err := hex.DecodeString(jsArgs[i].String())
					if err != nil {
						return toJS(map[string]any{
							"error": fmt.Sprintf("arg %q: invalid hex: %v", p.Name, err),
						})
					}
					args[i] = b
				case meshpkt.ParamInt:
					args[i] = jsArgs[i].Int()
				}
			}

			result, err := op.Run(args)
			if err != nil {
				return toJS(map[string]any{"error": err.Error()})
			}
			return toJS(result)
		}))
	}

	js.Global().Set(globalName, mc)
	select {}
}

func toJS(v any) js.Value {
	b, _ := json.Marshal(v)
	return js.Global().Get("JSON").Call("parse", string(b))
}
